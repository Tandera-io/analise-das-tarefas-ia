# Multi-Tenant Configuration
REGISTRY_API_URL=http://localhost:3000
# Token para autenticação service-to-service com o Registry (obter credenciais de backend)
# Deve ser o mesmo token configurado no Registry (REGISTRY_SERVICE_TOKEN)
REGISTRY_SERVICE_TOKEN=your-secret-service-token-here
# Tenant padrão: use 'dev' para desenvolvimento local, 'advice' para produção
DEFAULT_TENANT_SLUG=dev

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Supabase Configuration (Fallback - usado quando tenant não especificado)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key

# OpenAI Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# API Key for authentication
API_KEY=your_internal_api_key_here

# Server Configuration
PORT=8003

# Logging
LOG_LEVEL=INFO
